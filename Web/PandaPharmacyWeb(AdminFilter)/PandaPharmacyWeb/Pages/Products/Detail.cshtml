@page
@using PandaPharmacyWeb.Models;
@model PandaPharmacyWeb.Pages.Products.DetailModel
@{
    ViewData["Title"] = "商品詳細";
}


<h1>商品詳細</h1>
<hr />

@if (Model.Product != null)
{
    <div class="form-group mb-2">
        <label asp-for="@Model.Product.ProductId" class=" form-label">商品ID</label>
        <input asp-for="@Model.Product.ProductId" class="form-control" readonly />
    </div>
    <div class="form-group mb-2">
        <label asp-for="@Model.Product.ProductName" class="form-label">商品名</label>
        <input asp-for="@Model.Product.ProductName" class="form-control" readonly />
    </div>
    <div class="form-group mb-2">
        <label asp-for="@Model.Product.Price" class="form-label">価格</label>
        <input asp-for="@Model.Product.Price" class="form-control" readonly />
    </div>
    <div class="form-group mb-2">
        <label asp-for="@Model.Product.Memo" class="form-label">説明文</label>
        <input asp-for="@Model.Product.Memo" class="form-control" readonly />
    </div>
    <div class="form-group mb-2">
        <label asp-for="@Model.Product.CategoryName" class="form-label">カテゴリ</label>
        <input asp-for="@Model.Product.CategoryName" class="form-control" readonly />
    </div>
}
else
{
    <p>対象の商品が存在しません</p>
}

<hr />
<div>
    <a class="btn btn-outline-primary" href="/Products/Edit?ProductId=@Model.Product?.ProductId">編集</a>
    <a class="btn btn-outline-primary" href="/Products/Index">一覧に戻る</a>
</div>

