@page
@using PandaPharmacyWeb.Models;
@model PandaPharmacyWeb.Pages.Products.CreateModel
@{
    ViewData["Title"] = "商品作成";
}

<h1>商品作成</h1>
<hr />

@if (Model.Product != null && Model.Categories != null)
{
    <form method="post">
        <div class="form-group mb-2">
            <label asp-for="@Model.Product.ProductName" class="form-label">商品名</label>
            <input asp-for="@Model.Product.ProductName" class="form-control" />
            <span asp-validation-for="@Model.Product.ProductName" class="text-danger"></span>
        </div>
        <div class="form-group mb-2">
            <label asp-for="@Model.Product.Price" class="form-label">価格</label>
            <input asp-for="@Model.Product.Price" class="form-control" />
            <span asp-validation-for="@Model.Product.Price" class="text-danger"></span>
        </div>
        <div class="form-group mb-2">
            <label asp-for="@Model.Product.Memo" class="form-label">説明文</label>
            <input asp-for="@Model.Product.Memo" class="form-control" />
            <span asp-validation-for="@Model.Product.Memo" class="text-danger"></span>
        </div>
        <div class="form-group mb-2">
            <label asp-for="@Model.Product.CategoryId" class="form-label">カテゴリ</label>
            <select asp-for="@Model.Product.CategoryId" class="form-control">
                @foreach (Category item in Model.Categories)
                {
                    <option label="@item.CategoryName" value="@item.CategoryId" />
                }
            </select>
            <span asp-validation-for="@Model.Product.CategoryId" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-secondary">作成</button>
    </form>
}

<hr />
<div>
    <a class="btn btn-outline-primary" href="/Products/Index">一覧に戻る</a>
</div>