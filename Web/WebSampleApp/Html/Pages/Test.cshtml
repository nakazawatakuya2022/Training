@page
@model IndexModel

<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="UTF-8">
    <title>ページタイトル</title>
</head>

<body>
    <p>好きな食べ物を選んでください(複数選択可)</p>

    <input type="checkbox" id="ramen" name="food" value="ramen">
    <label for="ramen">ラーメン</label>
    <br>

    <input type="checkbox" id="sushi" name="food" value="sushi" checked>
    <label for="sushi">寿司</label>
    <br>

    <input type="checkbox" id="curry" name="food" value="curry">
    <label for="curry">カレー</label>
</body>

</html>