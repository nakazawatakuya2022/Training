@page
@model WebSampleApp.Pages.S18RazorTestEx01Model
@{
    ViewData["Title"] = "S18RazorTestEx01";
}
<h2>名前をセッションに保存</h2>
<form method="post">
    <label asp-for="Name">名前を入力してください：</label>
    <input asp-for="Name" />
    <button type="submit">保存</button>
</form>
@if(Model.Name != null)
{
    <p>@Model.Name さんをセッションに保存しました。</p>
}