@page
@using UminekoWeb.Models
@model UminekoWeb.Pages.Books.LendModel

@{
    ViewData["Title"] = "貸出処理";
}

<h1>貸出処理</h1>

<hr />

@if (Model.Book != null)
{
    <form method="post">

        <input type="hidden"
               asp-for="@Model.LentHistory.BookId"
               value="@Model.Book.BookId" />

        <div class="form-group mb-2">
            <label class="form-label">蔵書ID</label>

            <input class="form-control"
                   value="@Model.Book.BookId"
                   readonly />
        </div>

        <div class="form-group mb-2">
            <label class="form-label">タイトル</label>

            <input class="form-control"
                   value="@Model.Book.Title"
                   readonly />
        </div>

        <div class="form-group mb-2">
            <label asp-for="@Model.LentHistory.MemberCode"
                   class="form-label">
                会員
            </label>

            <select asp-for="@Model.LentHistory.MemberCode"
                    class="form-select">

                @foreach (Member member in Model.Members)
                {
                    <option value="@member.MemberCode">
                        @member.MemberCode
                        （@member.MemberName）
                    </option>
                }

            </select>
        </div>

        <button type="submit"
                class="btn btn-primary">
            貸出
        </button>

    </form>
}
