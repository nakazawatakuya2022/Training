@page
@using UminekoWeb.Models
@model UminekoWeb.Pages.Books.LendModel

@{
    ViewData["Title"] = "貸出処理";
}

<h1>貸出処理</h1>

<hr />

@if (Model.Book != null)
{
    <form method="post">

        <!-- バリデーションエラー表示 -->
        <div asp-validation-summary="All"
             class="text-danger">
        </div>

        <!-- POST時にBookIdを送るためのhidden -->
        <input type="hidden"
               name="LentHistory.BookId"
               value="@Model.Book.BookId" />

        <!-- 蔵書ID -->
        <div class="form-group mb-2">
            <label class="form-label">蔵書ID</label>
            <input class="form-control"
                   value="@Model.Book.BookId"
                   readonly />
        </div>

        <!-- ISBN -->
        <div class="form-group mb-2">
            <label class="form-label">ISBN</label>
            <input class="form-control"
                   value="@Model.Book.Isbn"
                   readonly />
        </div>

        <!-- タイトル -->
        <div class="form-group mb-2">
            <label class="form-label">タイトル</label>
            <input class="form-control"
                   value="@Model.Book.Title"
                   readonly />
        </div>

        <!-- 会員選択 -->
        <div class="form-group mb-2">
            <label asp-for="@Model.LentHistory.MemberCode"
                   class="form-label">
                借りる会員を選択してください
            </label>

            <select asp-for="@Model.LentHistory.MemberCode"
                    class="form-control">
                @foreach (Member member in Model.Members)
                {
                    <option value="@member.MemberCode">
                        @member.MemberCode（@member.MemberName）
                    </option>
                }
            </select>
        </div>

        <!-- メモ -->
        <div class="form-group mb-2">
            <label asp-for="@Model.LentHistory.Memo"
                   class="form-label">
                メモ
            </label>

            <input asp-for="@Model.LentHistory.Memo"
                   class="form-control" />
        </div>

        <!-- 貸出ボタン -->
        <button type="submit"
                class="btn btn-secondary">
            貸出
        </button>

        <hr />

        <!-- 詳細画面へ戻る -->
        <a class="btn btn-outline-primary"
           href="/Books/Detail?BookId=@Model.Book.BookId">
            蔵書詳細に戻る
        </a>

        <!-- 一覧画面へ戻る -->
        <a class="btn btn-outline-primary"
           href="/Books/Index">
            蔵書一覧に戻る
        </a>

    </form>
}