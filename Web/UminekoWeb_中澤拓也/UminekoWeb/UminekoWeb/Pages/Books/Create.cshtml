@page
<!--Modelsのプロパティを使用するために必要-->
@using UminekoWeb.Models
@model UminekoWeb.Pages.Books.CreateModel
@{
    ViewData["Title"] = "蔵書作成";
}

<h1>蔵書作成</h1>
<hr />

<form method="post">

    <div class="form-group mb-2">
        <label asp-for="@Model.Book.Isbn" class="form-label">ISBN</label>
        <input asp-for="@Model.Book.Isbn" class="form-control" />
        <span asp-validation-for="@Model.Book.Isbn" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="@Model.Book.Title" class="form-label">タイトル</label>
        <input asp-for="@Model.Book.Title" class="form-control" />
        <span asp-validation-for="@Model.Book.Title" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="@Model.Book.Author" class="form-label">著者</label>
        <input asp-for="@Model.Book.Author" class="form-control" />
        <span asp-validation-for="@Model.Book.Author" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="@Model.Book.Publisher" class="form-label">出版社</label>
        <input asp-for="@Model.Book.Publisher" class="form-control" />
        <span asp-validation-for="@Model.Book.Publisher" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="@Model.Book.PurchaseDate" class="form-label">購入日</label>
        <input asp-for="@Model.Book.PurchaseDate" class="form-control" />
        <span asp-validation-for="@Model.Book.PurchaseDate" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="@Model.Book.PurchasePrice" class="form-label">購入価格</label>
        <input asp-for="@Model.Book.PurchasePrice" class="form-control" />
        <span asp-validation-for="@Model.Book.PurchasePrice" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="@Model.Book.Memo" class="form-label">メモ</label>
        <textarea asp-for="@Model.Book.Memo" class="form-control"></textarea>
        <span asp-validation-for="@Model.Book.Memo" class="text-danger"></span>
    </div>

    <!--Book.CategoryId に、選択されたカテゴリIDが入ります。-->
    <div class="form-group mb-2">
        <label asp-for="@Model.Book.CategoryId" class="form-label">カテゴリ</label>
        <select asp-for="@Model.Book.CategoryId" class="form-control">
            @foreach (Category category in Model.Categories)
            {
                <option value="@category.CategoryId">
                    <!--category.CategoryNameは表示用-->
                    @category.CategoryName
                </option>
            }
        </select>
        <span asp-validation-for="@Model.Book.CategoryId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-secondary">作成</button>
    <hr>
    <a asp-page="Index" class="btn btn-outline-primary">一覧に戻る</a>
</form>