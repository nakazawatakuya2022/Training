@page
@model RazorPagesEx.Pages.Ex2_4_1Model

@{
    ViewData["Title"] = "Ex2_4_1";
}

<h2>電話番号入力フォーム</h2>

<form method="post">

    <div>
        <label asp-for="PhoneNumber">電話番号</label>
        <input asp-for="PhoneNumber" placeholder="電話番号を入力してください" />
        <span asp-validation-for="PhoneNumber"
              class="text-danger">
        </span>
    </div>

    <button type="submit">
        送信
    </button>

</form>