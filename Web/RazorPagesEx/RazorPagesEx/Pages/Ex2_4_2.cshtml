@page
@model RazorPagesEx.Pages.Ex2_4_2Model

@{
    ViewData["Title"] = "Ex2_4_2";
}
<style>
    input::placeholder {
        color: red;
        font-size: 10px;
    }

</style>


<h2>パスワード入力フォーム</h2>

<form method="post">

    <div>
        <label asp-for="Password">パスワード</label>
        <input type="password"
               asp-for="Password" minlength="8" maxlength="20" 
               placeholder="パスワードは8文字以上20文字以内" />
        <span asp-validation-for="Password"
              class="text-danger">
        </span>
    </div>

    <button type="submit">
        送信
    </button>

</form>