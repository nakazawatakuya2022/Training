@page
@using HimawariRentalWeb.Models
@model HimawariRentalWeb.Pages.RentalItems.RentModel
@{
    ViewData["Title"] = "レンタル処理";
}

<h1>レンタル処理</h1>
<hr />

<form method="post">
    <div class="mb-2">
        <label asp-for="@Model.RentalItem.RentalItemId" class=" form-label">レンタル品ID</label>
        <input asp-for="@Model.RentalItem.RentalItemId" class="form-control" readonly />
    </div>
    <div class="mb-2">
        <label asp-for="@Model.RentalItem.ManagementCode" class="form-label">管理番号</label>
        <input asp-for="@Model.RentalItem.ManagementCode" class="form-control" readonly />
    </div>
    <div class="mb-2">
        <label asp-for="@Model.RentalItem.ItemName" class="form-label">品名</label>
        <input asp-for="@Model.RentalItem.ItemName" class="form-control" readonly />
    </div>
    <div class="mb-2">
        <label asp-for="@Model.RentalHistory.CustomerCode" class="form-label">借りる顧客を選択してください</label>
        <select asp-for="@Model.RentalHistory.CustomerCode" class="form-select">
            @foreach (Customer item in Model.Customers)
            {
                <option label="@(item.CustomerCode + "(" + item.CustomerName + ")")" value="@item.CustomerCode" />
            }
        </select>
        <span asp-validation-for="@Model.RentalHistory.CustomerCode" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="@Model.RentalHistory.Memo" class="form-label">メモ</label>
        <input asp-for="@Model.RentalHistory.Memo" class="form-control" />
        <span asp-validation-for="@Model.RentalHistory.Memo" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-secondary">レンタル</button>
</form>
<hr />
<div>
    <a class="btn btn-outline-primary" href="/RentalItems/Detail?RentalItemId=@Model.RentalItem.RentalItemId">レンタル品詳細に戻る</a>
    <a class="btn btn-outline-primary" href="/RentalItems/Index">レンタル品一覧に戻る</a>
</div>
