@page
@using HimawariRentalWeb.Models
@model HimawariRentalWeb.Pages.RentalItems.RankingModel
@{
    ViewData["Title"] = "ランキング";
}

<h1>ランキング</h1>

<form method="get">
    <div class="mb-2">
        <label asp-for="@Model.StartDate" class=" form-label">期間開始日</label>
        <input asp-for="@Model.StartDate" />
    </div>
    <div class="mb-2">
        <label asp-for="@Model.EndDate" class=" form-label">期間終了日</label>
        <input asp-for="@Model.EndDate" />
    </div>
    <button type="submit" class="btn btn-secondary">出力</button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>順位</th>
            <th>レンタル数</th>
            <th>レンタル品ID</th>
            <th>管理番号</th>
            <th>品名</th>
            <th>メーカー</th>
            <th>保管場所</th>
            <th>カテゴリ</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.RentalItems.Count; i++)
        {
            RankingRentalItem item = Model.RentalItems[i];
            <tr>
                <td>@(i + 1)</td>
                <td>@item.RentalTimes</td>
                <td>@item.RentalItemId</td>
                <td>@item.ManagementCode</td>
                <td>@item.ItemName</td>
                <td>@item.Maker</td>
                <td>@item.StorageLocation</td>
                <td>@item.CategoryName</td>
            </tr>
        }
    </tbody>
</table>