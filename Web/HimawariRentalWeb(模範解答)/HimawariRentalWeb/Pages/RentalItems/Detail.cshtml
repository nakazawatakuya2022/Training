@page
@using HimawariRentalWeb.Models
@model HimawariRentalWeb.Pages.RentalItems.DetailModel
@{
    ViewData["Title"] = "レンタル品詳細";
}

<h1>レンタル品詳細</h1>
<hr />

<form method="post">
    <div class="mb-2">
        <label asp-for="@Model.RentalItem.RentalItemId" class=" form-label">レンタル品ID</label>
        <input asp-for="@Model.RentalItem.RentalItemId" class="form-control" readonly />
    </div>
    <div class="mb-2">
        <label asp-for="@Model.RentalItem.ManagementCode" class="form-label">管理番号</label>
        <input asp-for="@Model.RentalItem.ManagementCode" class="form-control" readonly />
    </div>
    <div class="mb-2">
        <label asp-for="@Model.RentalItem.ItemName" class="form-label">品名</label>
        <input asp-for="@Model.RentalItem.ItemName" class="form-control" readonly />
    </div>
    <div class="mb-2">
        <label asp-for="@Model.RentalItem.Maker" class="form-label">メーカー</label>
        <input asp-for="@Model.RentalItem.Maker" class="form-control" readonly />
    </div>
    <div class="mb-2">
        <label asp-for="@Model.RentalItem.StorageLocation" class="form-label">保管場所</label>
        <input asp-for="@Model.RentalItem.StorageLocation" class="form-control" readonly />
    </div>
    <div class="mb-2">
        <label asp-for="@Model.RentalItem.PurchaseDate" class="form-label">購入日</label>
        <input asp-for="@Model.RentalItem.PurchaseDate" class="form-control" readonly />
    </div>
    <div class="mb-2">
        <label asp-for="@Model.RentalItem.PurchasePrice" class="form-label">購入価格</label>
        <input asp-for="@Model.RentalItem.PurchasePrice" class="form-control" readonly />
    </div>
    <div class="mb-2">
        <label asp-for="@Model.RentalItem.Memo" class="form-label">メモ</label>
        <input asp-for="@Model.RentalItem.Memo" class="form-control" readonly />
    </div>
    <div class="mb-2">
        <label asp-for="@Model.RentalItem.CategoryName" class="form-label">カテゴリ</label>
        <input asp-for="@Model.RentalItem.CategoryName" class="form-control" readonly />
    </div>
</form>

<h3>@(Model.RentalItem.RentalFlag ? "レンタル中" : "利用可")</h3>

<hr />
<div>
    <a class="btn btn-outline-primary" href="/RentalItems/Edit?RentalItemId=@Model.RentalItem.RentalItemId">編集</a>
    @if (Model.RentalItem.RentalFlag)
    {
        <a class="btn btn-outline-primary" href="/RentalItems/Return?RentalItemId=@Model.RentalItem.RentalItemId">返却処理</a>
    }
    else
    {
        <a class="btn btn-outline-primary" href="/RentalItems/Rent?RentalItemId=@Model.RentalItem.RentalItemId">レンタル処理</a>
    }
    <a class="btn btn-outline-primary" href="/RentalItems/Index">一覧に戻る</a>
</div>

<hr />
<table class="table">
    <thead>
        <tr>
            <th>レンタル日</th>
            <th>顧客番号</th>
            <th>返却日</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RentalHistories != null)
        {
            @foreach (RentalHistory item in Model.RentalHistories)
            {
                <tr>
                    <td>@item.RentalDate?.ToString("yyyy-MM-dd")</td>
                    <td>@item.CustomerCode</td>
                    <td>@item.ReturnDate?.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        }
    </tbody>
</table>
