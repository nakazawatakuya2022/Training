@page
@model HimawariRentalWeb.Pages.RentalItems.DeleteModel

<h1>レンタル品削除</h1>

<p class="text-danger">以下のレンタル品を削除します。よろしいですか？</p>

@if (Model.RentalItem != null)
{
    <form method="post">
        <input type="hidden" name="id" value="@Model.RentalItem.RentalItemId" />

        <dl class="row">
            <dt class="col-sm-2">管理番号</dt>
            <dd class="col-sm-10">@Model.RentalItem.ManagementCode</dd>

            <dt class="col-sm-2">品名</dt>
            <dd class="col-sm-10">@Model.RentalItem.ItemName</dd>

            <dt class="col-sm-2">メーカー</dt>
            <dd class="col-sm-10">@Model.RentalItem.Maker</dd>

            <dt class="col-sm-2">保管場所</dt>
            <dd class="col-sm-10">@Model.RentalItem.StorageLocation</dd>

            <dt class="col-sm-2">カテゴリ</dt>
            <dd class="col-sm-10">@Model.RentalItem.CategoryName</dd>
        </dl>

        <button type="submit" class="btn btn-danger">削除</button>
        <a asp-page="Index" class="btn btn-secondary">戻る</a>
    </form>
}