@page
@using HimawariRentalWeb.Models
@model HimawariRentalWeb.Pages.RentalItems.CreateModel

<h1>レンタル品登録</h1>

<hr />

<form method="post">
    <div class="form-group mb-2">
        <label asp-for="RentalItem.ManagementCode" class="form-label">管理コード</label>
        <input asp-for="RentalItem.ManagementCode" class="form-control" />
        <span asp-validation-for="RentalItem.ManagementCode" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="RentalItem.ItemName" class="form-label">品名</label>
        <input asp-for="RentalItem.ItemName" class="form-control" />
        <span asp-validation-for="RentalItem.ItemName" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="RentalItem.CategoryId" class="form-label">カテゴリ</label>
        <select asp-for="RentalItem.CategoryId" class="form-control">
            @foreach (Category category in Model.Categories)
            {
                <option value="@category.CategoryId">
                    @category.CategoryName
                </option>
            }
        </select>
        <span asp-validation-for="RentalItem.CategoryId" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="RentalItem.Maker" class="form-label">メーカー</label>
        <input asp-for="RentalItem.Maker" class="form-control" />
        <span asp-validation-for="RentalItem.Maker" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="RentalItem.StorageLocation" class="form-label">保管場所</label>
        <input asp-for="RentalItem.StorageLocation" class="form-control" />
        <span asp-validation-for="RentalItem.StorageLocation" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">登録</button>
    <a asp-page="Index" class="btn btn-secondary">戻る</a>
</form>