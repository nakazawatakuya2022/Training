@page
@model YokoamiPetWeb.Pages.Histories.EditModel

@{
    ViewData["Title"] = "実施サービス更新";
}

<h1>実施サービス更新</h1>

<form method="post">

    <input type="hidden" asp-for="History.Id" />

    <div class="mb-3">
        <label asp-for="History.PetId" class="form-label">
            ペット
        </label>

        <select asp-for="History.PetId" class="form-control">
            @foreach (var pet in Model.Pets)
            {
                <option value="@pet.Id">
                    @pet.Name (@pet.OwnerName)
                </option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="History.ServiceId" class="form-label">
            サービス
        </label>

        <select asp-for="History.ServiceId" class="form-control">
            @foreach (var service in Model.Services)
            {
                <option value="@service.Id">
                    @service.Name
                </option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="History.ServiceDate" class="form-label">
            実施日時
        </label>

        <input asp-for="History.ServiceDate"
               type="datetime-local"
               class="form-control" />
    </div>

    <button type="submit" class="btn btn-warning">
        更新
    </button>

    <a asp-page="./Index" class="btn btn-secondary">
        戻る
    </a>

</form>