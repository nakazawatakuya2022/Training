@page
@using PandaPharmacyWeb.Models;
@model PandaPharmacyWeb.Pages.Orders.IndexModel

@{
    ViewData["Title"] = "注文一覧";
}

<h1>注文一覧</h1>

<a class="mb-2 btn btn-primary"
   href="/Orders/Create">
    新規作成
</a>

<table class="table">
    <thead>
        <tr>
            <th>注文ID</th>
            <th>注文日</th>
            <th>顧客番号</th>
            <th>商品ID</th>
            <th>数量</th>
            <th>操作</th>
        </tr>
    </thead>

    <tbody>
        @foreach (Order item in Model.Orders)
        {
            <tr>
                <td>@item.OrderId</td>
                <td>@item.OrderDate?.ToString("yyyy/MM/dd")</td>
                <td>@item.CustomerNo</td>
                <td>@item.ProductId</td>
                <td>@item.Quantity</td>
                <td>
                    <a class="btn btn-outline-primary"
                       href="/Orders/Detail?OrderId=@item.OrderId">
                        詳細
                    </a>

                    <a class="btn btn-outline-primary"
                       href="/Orders/Edit?OrderId=@item.OrderId">
                        編集
                    </a>

                    <a class="btn btn-outline-primary"
                       href="/Orders/Delete?OrderId=@item.OrderId">
                        削除
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>