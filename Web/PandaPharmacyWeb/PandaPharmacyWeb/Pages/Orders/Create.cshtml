@page
@using PandaPharmacyWeb.Models;
@model PandaPharmacyWeb.Pages.Orders.CreateModel
@{
    ViewData["Title"] = "注文作成";
}

<h1>注文作成</h1>
<hr />

<form method="post">
    <div class="mb-2">
        <label asp-for="@Model.Order.OrderDate" class="form-label">注文日</label>
        <input asp-for="@Model.Order.OrderDate" class="form-control" type="date" />
        <span asp-validation-for="@Model.Order.OrderDate" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="@Model.Order.CustomerNo" class="form-label">顧客番号</label>
        <input asp-for="@Model.Order.CustomerNo" class="form-control" />
        <span asp-validation-for="@Model.Order.CustomerNo" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="@Model.Order.ProductId" class="form-label">商品</label>
        <select asp-for="@Model.Order.ProductId" class="form-select">
            @foreach (Product item in Model.Products)
            {
                <option value="@item.ProductId">@item.ProductName</option>
            }
        </select>
        <span asp-validation-for="@Model.Order.ProductId" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="@Model.Order.Quantity" class="form-label">数量</label>
        <input asp-for="@Model.Order.Quantity" class="form-control" />
        <span asp-validation-for="@Model.Order.Quantity" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-secondary">作成</button>
</form>

<hr />
<div>
    <a class="btn btn-outline-primary" href="/Orders/Index">一覧に戻る</a>
</div>